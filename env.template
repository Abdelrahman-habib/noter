# Environment Configuration Template
# Copy this file to create environment-specific .env files

# For make: development.env, production.env, or test.env
# For scripts/docker-run.sh: dev.env or prod.env

# Server Configuration
HOST=localhost
PORT=4000
ENVIROMENT=development

# Database Configuration (PostgreSQL)
# Use postgres:5432 for Docker services, localhost:5433 from the host.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://noter_admin:admin@localhost:5433/noter?sslmode=disable
GOOSE_MIGRATION_DIR=./db/schema/migrations
GOOSE_SEED_DIR=./db/schema/seed
GOOSE_TABLE=goose_migrations
DB_DSN=postgres://noter_web:pass@localhost:5433/noter?sslmode=disable
TEST_DB_DSN=postgres://noter_test_web:test_pass@localhost:5433/noter_test?sslmode=disable

# Application Settings
DEBUG=true
LOG_LEVEL=debug
TLS_CERT=./tls/cert.pem
TLS_KEY=./tls/key.pem
